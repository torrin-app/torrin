# Torrin self-host configuration. Copy to .env and fill in.
# Blank values fall back to the defaults in the compose files, which are fine
# for a local test but should be set for a real deployment.

# ── Required ────────────────────────────────────────────────────────────────
# Public URL the stream service is reached at (your domain or IP). Signed
# stream URLs are minted against this, so it must be correct from the outside.
PUBLIC_URL=http://localhost:8084

# HMAC secret that signs stream URLs and internal calls. CHANGE THIS.
#   openssl rand -hex 32
SIGNING_KEY=change-me

# ── Storage ─────────────────────────────────────────────────────────────────
# Cached content lives on the local filesystem. The compose mounts the host
# path /mnt/cache/store into the services; point that at your cache disk (or
# edit the volume in docker-compose.yml).

# Optional: hex key to encrypt stored content at rest (default off).
#   openssl rand -hex 32
STORAGE_KEY=

# Optional: hex key to encrypt stored debrid credentials at rest.
CREDS_KEY=

# ── Download VPN (docker-compose.vpn.yml overlay) ───────────────────────────
# Downloads run inside gluetun so the host IP is never exposed. Fill these if
# you use the vpn overlay (recommended).
VPN_PROVIDER=airvpn
VPN_TYPE=wireguard
VPN_PRIVATE_KEY=
VPN_PRESHARED_KEY=
VPN_ADDRESSES=
VPN_COUNTRIES=Germany

# ── Cache limits ────────────────────────────────────────────────────────────
BUDGET_MAX_BYTES=1000000000000
EVICTION_CAP_BYTES=300000000000
EVICTION_HOUR=4

# ── Multi-node cache pool (optional; leave blank for single-box) ─────────────
# NODE_ID: this box's id, stamped on jobs it publishes (blank = single-box)
# CLUSTER_NODES: ordered overflow nodes with caps, e.g. node2:45TB,node3:50TB
NODE_ID=
NODE2_ID=
CLUSTER_NODES=

# ── Optional: system debrid keys for the instant cache-check ────────────────
# Users add their own keys in the app; these only power the "is it cached"
# probe. Leave blank to skip.
RD_API_KEY=
AD_API_KEY=
TORRENTCLAW_API_KEY=

# ── Optional: Usenet backend + indexer ──────────────────────────────────────
USENET_HOST=
USENET_PORT=563
USENET_USER=
USENET_PASS=
USENET_MAXCONNS=20
USENET_INDEXER_URL=
USENET_INDEXER_KEY=

# ── Optional: BYOS cloud OAuth (Bring Your Own Storage) ─────────────────────
# Only needed if users will connect Google Drive / Dropbox / OneDrive / pCloud.
API_PUBLIC_URL=
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=

# ── Optional: rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=60
